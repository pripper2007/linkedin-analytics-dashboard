# ---------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in real values. NEVER commit
# `.env.local` — it is gitignored. All of these also need to be set as
# Environment Variables in your Vercel project (Settings → Environment
# Variables) for the deployed app.
# ---------------------------------------------------------------------------

# --- Database (Supabase Postgres) ------------------------------------------
# Create a free project at https://supabase.com, then copy the connection
# string from Project Settings → Database → Connection string.
# IMPORTANT: use the *Session pooler* URL (port 6543) for serverless —
# the direct connection (5432) exhausts connections on Vercel.
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres"

# --- Personalization (optional) --------------------------------------------
# Make the dashboard yours: these show in the browser title, the login
# screen, and the sidebar. NEXT_PUBLIC_ so they reach client components — set
# them at build time (locally and in Vercel). Leave blank for neutral copy.
NEXT_PUBLIC_OWNER_NAME=""
NEXT_PUBLIC_OWNER_TITLE=""
# IANA timezone for the posting-time heatmap + cadence analysis. Set it to
# your audience's zone so "best day / best hour" insights are meaningful.
# Defaults to America/Sao_Paulo. Examples: America/New_York, Europe/London.
ANALYTICS_TIMEZONE=""

# --- Dashboard auth --------------------------------------------------------
# The single shared password to log into the dashboard UI.
DASHBOARD_PASSWORD="choose-a-strong-password"
# Secret used to sign the `dashboard_session` cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="generate-a-random-64-char-hex-string"

# --- Ingest (browser extension → API) --------------------------------------
# Shared secret the extension sends in the `X-Ingest-Secret` header. Must
# match the value you paste into the extension's Options page. Generate with
# the same randomBytes command as SESSION_SECRET.
INGEST_SECRET="generate-a-random-64-char-hex-string"
# Only needed by the local helper scripts that POST to a running instance.
# In the extension this is configured in the Options page, not here.
INGEST_URL="http://localhost:3000/api/ingest"

# --- AI features (optional) ------------------------------------------------
# Powers /idea-cloud (topic clustering) and the per-post critique on
# /posts/[id]. Without it those features degrade gracefully (return null /
# show a "not configured" notice). Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY="sk-ant-..."

# --- Media mirroring (optional) --------------------------------------------
# Vercel Blob token, for mirroring post images so they don't hotlink to
# LinkedIn's CDN. Create a Blob store in your Vercel project and copy the
# read-write token. Without it, media mirroring is a no-op.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."
